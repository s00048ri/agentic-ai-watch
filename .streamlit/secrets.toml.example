# Copy into the app's Secrets on Streamlit Community Cloud (never commit real values).

[github]
owner = "s00048ri"
repo = "agentic-ai-watch"
branch = "main"
# Fine-grained personal access token: this repository only, "Contents: Read and write".
token = "github_pat_..."

[app]
# Only these accounts can use the app (lower case).
allowed_emails = ["name@example.org"]

[auth]
redirect_uri = "https://<your-app>.streamlit.app/oauth2callback"
cookie_secret = "<a long random string>"
client_id = "<OAuth client id>"
client_secret = "<OAuth client secret>"
# Google accounts. For Microsoft 365 use
# https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
